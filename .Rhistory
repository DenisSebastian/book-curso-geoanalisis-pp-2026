# convertir de Dataframe (con lat, lon) en objeto
df2sf <- function(df, lon ="lon", lat ="lat", crs_base = 4326) {
sf_object <- df %>%
dplyr::filter(!is.na(.data[[lon]])|!is.na(.data[[lat]])) %>%
sf::st_as_sf(coords = c(x = lon, y = lat),
crs = crs_base, agr = "constant")
return(sf_object)
}
